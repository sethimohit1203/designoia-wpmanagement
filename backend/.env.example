PORT=5000

# Dashboard login (backend/src/routes/auth.js). Only used to BOOTSTRAP the password hash
# into the DB on first boot (db/index.js) — after that, the DB value is the source of
# truth (so "Forgot password" resets persist across restarts). Set a strong value in
# backend/.env — never commit it.
DASHBOARD_PASSWORD=
# Secret used to sign/verify login + password-reset JWTs. Set a long random string in
# backend/.env — never commit it.
JWT_SECRET=

# "Forgot password" email (backend/src/services/emailService.js, routes/auth.js).
# Single shared-password app — resets always go to this one fixed inbox, not a
# user-supplied address. Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_USER=your@gmail.com, SMTP_PASS=<16-char Gmail App Password, not your real password>.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/sheets/oauth/callback
FRONTEND_URL=http://localhost:5173
