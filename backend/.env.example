PORT=5000

# Dashboard login (backend/src/routes/auth.js). Set a strong value in backend/.env — never commit it.
DASHBOARD_PASSWORD=
# Secret used to sign/verify login JWTs. Set a long random string in backend/.env — never commit it.
JWT_SECRET=

GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/sheets/oauth/callback
FRONTEND_URL=http://localhost:5173
